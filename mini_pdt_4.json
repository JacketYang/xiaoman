G", "string_value": ""}, {"row": 222, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 222, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 222, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 222, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 223, "col": 0, "value_type": "NUMBER", "number_value": 223}, {"row": 223, "col": 1, "value_type": "STRING", "string_value": "消防控制室不能远程手动启停风机的原因为多线控制盘未解锁处于“手动禁止”状态,则维修方法为：将多线控制盘解锁为“手动允许”状态。（  ）"}, {"row": 223, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 223, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 223, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 223, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 223, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 223, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 223, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 224, "col": 0, "value_type": "NUMBER", "number_value": 224}, {"row": 224, "col": 1, "value_type": "STRING", "string_value": "维修灭火器时，再充装灭火剂之前，应对未更换的零部件进行清洁处理。（  ）"}, {"row": 224, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 224, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 224, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 224, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 224, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 224, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 224, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 225, "col": 0, "value_type": "NUMBER", "number_value": 225}, {"row": 225, "col": 1, "value_type": "STRING", "string_value": "维修灭火器时，当阀门与瓶体的连接螺纹锈住时，可以用硬物捶打方式拆卸。（  ）"}, {"row": 225, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 225, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 225, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 225, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 225, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 225, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 225, "col": 8, "value_type": "STRING", "string_value": "维修灭火器时，当阀门与瓶体的连接螺纹锈住时，不能用硬物捶打，可采用松锈剂喷涂后再拆卸。"}, {"row": 226, "col": 0, "value_type": "NUMBER", "number_value": 226}, {"row": 226, "col": 1, "value_type": "STRING", "string_value": "推车贮压式水基型灭火器主要由瓶体、瓶头阀门、阀门开启手柄、铭牌标志、灭火剂及驱动气体、车架及车轮等零部件组成。（  ）"}, {"row": 226, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 226, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 226, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 226, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 226, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 226, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 226, "col": 8, "value_type": "STRING", "string_value": "推车贮压式水基型灭火器主要由瓶体、瓶头阀门、阀门开启手柄、压力指示器、保险装置、封记、虹吸管与过滤网、喷射软管、喷射控制枪及喷嘴、铭牌标志、灭火剂及驱动气体、车架及车轮等零部件组成。"}, {"row": 227, "col": 0, "value_type": "NUMBER", "number_value": 227}, {"row": 227, "col": 1, "value_type": "STRING", "string_value": "特殊响应喷头是指平均响应时间系数（RTI）小于或等于50（m.s）0.5。（  ）"}, {"row": 227, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 227, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 227, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 227, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 227, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 227, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 227, "col": 8, "value_type": "STRING", "string_value": "特殊响应喷头是指平均响应时间系数（RTI）介于50~80（m.s）0.5"}, {"row": 228, "col": 0, "value_type": "NUMBER", "number_value": 228}, {"row": 228, "col": 1, "value_type": "STRING", "string_value": "手提式水基型灭火器超过出厂时间6年应报废。（  ）"}, {"row": 228, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 228, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 228, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 228, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 228, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 228, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 228, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 229, "col": 0, "value_type": "NUMBER", "number_value": 229}, {"row": 229, "col": 1, "value_type": "STRING", "string_value": "室外消火栓系统按管网布置形式可分为环状管网消火栓系统和枝状管网消火栓系统。（  ）"}, {"row": 229, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 229, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 229, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 229, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 229, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 229, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 229, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 230, "col": 0, "value_type": "NUMBER", "number_value": 230}, {"row": 230, "col": 1, "value_type": "STRING", "string_value": "室内环境温度低于4℃或高于70℃的场所，宜采用干式消火栓系统。（  ）"}, {"row": 230, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 230, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 230, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 230, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 230, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 230, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 230, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 231, "col": 0, "value_type": "NUMBER", "number_value": 231}, {"row": 231, "col": 1, "value_type": "STRING", "string_value": "排烟防火阀应用场所为机械加压送风系统。（  ）"}, {"row": 231, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 231, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 231, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 231, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 231, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 231, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 231, "col": 8, "value_type": "STRING", "string_value": "排烟防火阀应用场所为机械排烟系统。"}, {"row": 232, "col": 0, "value_type": "NUMBER", "number_value": 232}, {"row": 232, "col": 1, "value_type": "STRING", "string_value": "排烟防火阀280℃时自动关闭。（  ）"}, {"row": 232, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 232, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 232, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 232, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 232, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 232, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 232, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 233, "col": 0, "value_type": "NUMBER", "number_value": 233}, {"row": 233, "col": 1, "value_type": "STRING", "string_value": "灭火器已经被使用过，拆卸时可以将瓶头阀门顶部对准人体。（  ）"}, {"row": 233, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 233, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 233, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 233, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 233, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 233, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 233, "col": 8, "value_type": "STRING", "string_value": "无论灭火器是否被使用过，拆卸瓶头阀门前一定要先卸压，且拆卸时不能将瓶头阀门顶部对准人体。"}, {"row": 234, "col": 0, "value_type": "NUMBER", "number_value": 234}, {"row": 234, "col": 1, "value_type": "STRING", "string_value": "灭火器维修工作包括维修前检查、拆卸灭火器、灭火剂回收处置、受压零部件的水压试验、零部件更换、再充装、报废与回收处置、质量检验等活动。（  ）"}, {"row": 234, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 234, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 234, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 234, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 234, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 234, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 234, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 235, "col": 0, "value_type": "NUMBER", "number_value": 235}, {"row": 235, "col": 1, "value_type": "STRING", "string_value": "更换消防应急灯具之前，只关闭应急照明控制器即可。（  ）"}, {"row": 235, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 235, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 235, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 235, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 235, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 235, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 235, "col": 8, "value_type": "STRING", "string_value": "更换消防应急灯具之前，关闭应急照明控制器和消防集中应急电源，切断消防应急灯具供电，保证灯具更换工作的整个过程都是在断电的环境下进行。"}, {"row": 236, "col": 0, "value_type": "NUMBER", "number_value": 236}, {"row": 236, "col": 1, "value_type": "STRING", "string_value": "更换室内消火栓时，若消火栓附近设置有检修蝶阀,关闭该蝶阀即可。（  ）"}, {"row": 236, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 236, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 236, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 236, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 236, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 236, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 236, "col": 8, "value_type": "STRING", "string_value": "关闭拟更换消火栓的供水阀门方法：（1）若消火栓附近设置有检修蝶阀,关闭该蝶阀即可。（2）若未设置检修蝶阀，则关闭该消火栓所在的竖管与供水横干管相接处的供水控制阀。（3）前2种方式均无法实现时，则关闭高位消防水箱消火栓系统出水管路控制阀,并可通过打开消防水池处消火栓系统泄水阀或消防水泵试水管路辅助排水。"}, {"row": 237, "col": 0, "value_type": "NUMBER", "number_value": 237}, {"row": 237, "col": 1, "value_type": "STRING", "string_value": "更换干式报警阀阀瓣密封圈时，推动自动滴水阀的推杆，推杆能伸缩且流水已很微小时即可认定水已排尽。（  ）"}, {"row": 237, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 237, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 237, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 237, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 237, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 237, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 237, "col": 8, "value_type": "STRING", "string_value": "打开供水侧放水阀和系统上全部辅助排水阀门，排出余水；推动自动滴水阀的推杆，推杆能伸缩且流水已很微小时即可认定水已排尽。"}, {"row": 238, "col": 0, "value_type": "NUMBER", "number_value": 238}, {"row": 238, "col": 1, "value_type": "STRING", "string_value": "更换防火卷帘手动按钮盒前应关闭防火卷帘控制器电源。（  ）"}, {"row": 238, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 238, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 238, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 238, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 238, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 238, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 238, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 239, "col": 0, "value_type": "NUMBER", "number_value": 239}, {"row": 239, "col": 1, "value_type": "STRING", "string_value": "更换点型（感烟、感温）火灾探测器：顺时针旋转点型（感烟、感温）火灾探测器，将探测器部分与底座脱离。（  ）"}, {"row": 239, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 239, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 239, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 239, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 239, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 239, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 239, "col": 8, "value_type": "STRING", "string_value": "更换点型（感烟、感温）火灾探测器：逆时针旋转点型（感烟、感温）火灾探测器，将探测器部分与底座脱离。"}, {"row": 240, "col": 0, "value_type": "NUMBER", "number_value": 240}, {"row": 240, "col": 1, "value_type": "STRING", "string_value": "更换闭式洒水喷头前，应先关闭该喷头所在分区水流指示器前的控制阀，再打开末端试水装置排出管道存水，然后再更换喷头.。（  ）"}, {"row": 240, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 240, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 240, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 240, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 240, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 240, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 240, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 241, "col": 0, "value_type": "NUMBER", "number_value": 241}, {"row": 241, "col": 1, "value_type": "STRING", "string_value": "风机运行振动剧烈原因可能为叶轮变形或不平衡。（  ）"}, {"row": 241, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 241, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 241, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 241, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 241, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 241, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 241, "col": 8, "value_type": "STRING", "string_value": "风机运行振动剧烈原因：（1）叶轮变形或不平衡（2）轴承磨损或松动（3）风机轴与电动机轴不同心（4）叶轮定位螺栓或夹轮螺栓松动（5）叶片质量不对称或部分叶片磨损、腐蚀（6）叶片上附有不均匀的附着物（7）基础螺栓松动，引起共振"}, {"row": 242, "col": 0, "value_type": "NUMBER", "number_value": 242}, {"row": 242, "col": 1, "value_type": "STRING", "string_value": "风机运行温度异常原因为流量超过额定值，则维修方法为关小阀门。（  ）"}, {"row": 242, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 242, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 242, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 242, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 242, "col": 6, "value_type": "