tring_value": ""}, {"row": 189, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 189, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 189, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 190, "col": 0, "value_type": "NUMBER", "number_value": 190}, {"row": 190, "col": 1, "value_type": "STRING", "string_value": "防排烟联动控制中，由排烟口、排烟窗或排烟阀开启的动作信号作为排烟风机启动的联动触发信号，并由消防联动控制器联动控制排烟风机的启动"}, {"row": 190, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 190, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 190, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 190, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 190, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 190, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 190, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 191, "col": 0, "value_type": "NUMBER", "number_value": 191}, {"row": 191, "col": 1, "value_type": "STRING", "string_value": "防排烟联动控制中，当防火分区内火灾确认后，应只开启该防火分区内着火层前室及合用前室的常闭送风口，同时开启加压送风机"}, {"row": 191, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 191, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 191, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 191, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 191, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 191, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 191, "col": 8, "value_type": "STRING", "string_value": "当防火分区内火灾确认后，应能在15s内联动开启常闭加压送风口和加压送风机，并应符合下列规定：1）应开启该防火分区楼梯间的全部加压送风机。2）应开启该防火分区内着火层及其相邻上下层前室及合用前室的常闭送风口，同时开启加压送风机"}, {"row": 192, "col": 0, "value_type": "NUMBER", "number_value": 192}, {"row": 192, "col": 1, "value_type": "STRING", "string_value": "防火门监控器上接防火门监控模块和电动闭门器、电磁释放器、门磁开关等现场执行部件，下接火灾报警控制器"}, {"row": 192, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 192, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 192, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 192, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 192, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 192, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 192, "col": 8, "value_type": "STRING", "string_value": "防火门监控器是用于显示并控制防火门打开、关闭状态的控制装置，其上接火灾报警控制器，下接防火门监控模块和电动闭门器、电磁释放器、门磁开关等现场执行部件"}, {"row": 193, "col": 0, "value_type": "NUMBER", "number_value": 193}, {"row": 193, "col": 1, "value_type": "STRING", "string_value": "防火门处于故障状态时，防火门监控器应能发出声光报警信号。声信号的声压级（正前方1m处）应为65~85dB。"}, {"row": 193, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 193, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 193, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 193, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 193, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 193, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 193, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 194, "col": 0, "value_type": "NUMBER", "number_value": 194}, {"row": 194, "col": 1, "value_type": "STRING", "string_value": "防火门按日常启闭状态可分为常闭式防火门和常开式防火门"}, {"row": 194, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 194, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 194, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 194, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 194, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 194, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 194, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 195, "col": 0, "value_type": "NUMBER", "number_value": 195}, {"row": 195, "col": 1, "value_type": "STRING", "string_value": "防火卷帘具有现场手动电控、自动控制、消防控制室远程手动控制、温控释放控制、速放控制、现场机械控制和限位控制主要控制方式"}, {"row": 195, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 195, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 195, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 195, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 195, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 195, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 195, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 196, "col": 0, "value_type": "NUMBER", "number_value": 196}, {"row": 196, "col": 1, "value_type": "STRING", "string_value": "防火卷帘按帘面数量可分为单帘面防火卷帘和双帘面防火卷帘"}, {"row": 196, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 196, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 196, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 196, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 196, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 196, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 196, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 197, "col": 0, "value_type": "NUMBER", "number_value": 197}, {"row": 197, "col": 1, "value_type": "STRING", "string_value": "防火卷帘按材质可分为钢质防火卷帘、无机纤维复合防火卷帘。"}, {"row": 197, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 197, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 197, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 197, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 197, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 197, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 197, "col": 8, "value_type": "STRING", "string_value": "防火卷帘按材质可分为钢质防火卷帘、无机纤维复合防火卷帘和特级防火卷帘。"}, {"row": 198, "col": 0, "value_type": "NUMBER", "number_value": 198}, {"row": 198, "col": 1, "value_type": "STRING", "string_value": "发生火灾时，加压送风应做到：防烟楼梯间压力>走道压力>前室压力>房间压力"}, {"row": 198, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 198, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 198, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 198, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 198, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 198, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 198, "col": 8, "value_type": "STRING", "string_value": "发生火灾时，加压送风应做到：防烟楼梯间压力>前室压力>走道压力>房间压力"}, {"row": 199, "col": 0, "value_type": "NUMBER", "number_value": 199}, {"row": 199, "col": 1, "value_type": "STRING", "string_value": "发生火灾时，干式系统的闭式喷头受热开启，管道中的有压气体从喷头喷出，干式报警阀系统侧压力下降，造成干式报警阀水源侧压力大于系统侧压力，干式报警阀被自动打开，压力水进入供水管道"}, {"row": 199, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 199, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 199, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 199, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 199, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 199, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 199, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 200, "col": 0, "value_type": "NUMBER", "number_value": 200}, {"row": 200, "col": 1, "value_type": "STRING", "string_value": "多线控制盘的手动锁在“禁止”状态下，工作指示灯处于红灯运行状态，不能通过多线控制盘手动直接启动消防泵组、防烟和排烟风机等设备"}, {"row": 200, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 200, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 200, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 200, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 200, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 200, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 200, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 201, "col": 0, "value_type": "NUMBER", "number_value": 201}, {"row": 201, "col": 1, "value_type": "STRING", "string_value": "多线控制盘操作面板上设有多个手动控制单元，每个单元包括一个操作按钮和启动、反馈两个状态指示灯"}, {"row": 201, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 201, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 201, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 201, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 201, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 201, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 201, "col": 8, "value_type": "STRING", "string_value": "多线控制盘操作面板上设有多个手动控制单元，每个单元包括一个操作按钮和启动、反馈、故障三个状态指示灯"}, {"row": 202, "col": 0, "value_type": "NUMBER", "number_value": 202}, {"row": 202, "col": 1, "value_type": "STRING", "string_value": "对于普通电梯，在火灾情况下，其迫降要求是使电梯返回到指定层（一般为首层）并保持“开门待用”的状态。"}, {"row": 202, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 202, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 202, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 202, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 202, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 202, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 202, "col": 8, "value_type": "STRING", "string_value": "对于普通电梯，在火灾情况下，其迫降要求是使电梯返回到指定层（一般为首层）并退出正常服务，此后，电梯处于“开门停用”的状态。"}, {"row": 203, "col": 0, "value_type": "NUMBER", "number_value": 203}, {"row": 203, "col": 1, "value_type": "STRING", "string_value": "电梯的迫降有紧急迫降按钮迫降、消防控制室远程控制迫降、自动联动控制迫降三种方法"}, {"row": 203, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 203, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 203, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 203, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 203, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 203, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 203, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 204, "col": 0, "value_type": "NUMBER", "number_value": 204}, {"row": 204, "col": 1, "value_type": "STRING", "string_value": "当内部晶体管温度超过设定温度极限（90℃）6s后发生过温故障，消防应急广播系统过温灯指示灯应常亮"}, {"row": 204, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 204, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 204, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 204, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 204, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 204, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 204, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 205, "col": 0, "value_type": "NUMBER", "number_value": 205}, {"row": 205, "col": 1, "value_type": "STRING", "string_value": "当集中火灾报警控制器处于监控状态时，在系统菜单的操作页面下，按上、下键移动光标选中手/自动切换选项，或者直接按下手/自动切换选项对应的快捷数字键，输入系统操作密码后按确认键，控制器将从手动状态切换为自动状态。"}, {"row": 205, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 205, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 205, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 205, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 205, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 205, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 205, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 206, "col": 0, "value_type": "NUMBER", "number_value": 206}, {"row": 206, "col": 1, "value_type": "STRING", "string_value": "当集中火灾报警控制器、消防联动控制器处于手动状态时，收到火灾报警信息时，会在屏幕上显示火灾发生的位置信息、点亮火警指示灯、发出火警报警音，但不会联动启动声光报警、消防广播及所控制的现场消防设备。"}, {"row": 206, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 206, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 206, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 206, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 206, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 206, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 206, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 207, "col": 0, "value_type": "NUMBER", "number_value": 207}, {"row": 207, "col": 1, "value_type": "STRING", "string_value": "当火灾发生时，随着灭火设备开启用水，由于稳压泵流量较小，气压罐内的水量持续减少，罐内压力不断下降，当压力持续10S低于设定的消防泵组启动压力p1时，消防泵组自动启动向消防给水管网供水。"}, {"row": 207, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 207, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 207, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 207, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 207, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 207, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 207, "col": 8, "value_type": "STRING", "string_value": "当火灾发生时，随着灭火设备开启用水，由于稳压泵流量较小，气压罐内的水量持续减少，罐内压力不断下降，当压力持续10S低于设定的消防泵组启动压力p2时，消防泵组自动启动向消防给水管网供水。"}, {"row": 208, "col": 0, "value_type": "NUMBER", "number_value": 208}, {"row": 208, "col": 1, "value_type": "STRING", "string_value": "测试火灾显示盘故障报警功能时。将具有故障显示功能的火灾显示盘所辖区域内任意一只感烟火灾探测器或感温火灾探测器从其底座上拆卸下来，火灾显示盘在火灾报警控制器发出故障信号后3s内发出故障声、光信号，指示故障发生部位，红色故障指示灯点亮。"}, {"row": 208, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 208, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 208, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 208, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 208, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 208, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 208, "col": 8, "value_type": "STRING", "string_value": "将具有故障显示功能的火灾显示盘所辖区域内任意一只感烟火灾探测器或感温火灾探测器从其底座上拆卸下来，火灾显示盘在火灾报警控制器发出故障信号后3s内发出故障声、光信号，指示故障发生部位，黄色故障指示灯点亮。"}, {"row": 209, "col": 0, "value_type": "NUMBER", "number_value": 209}, {"row": 209, "col": 1, "value_type": "STRING", "string_value": "消防应急广播系统的保养操作完成后，只需对消防应急广播系统进行复位即可。（  ）"}, {"row": 209, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 209, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 209, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 209, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 209, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 209, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 209, "col": 8, "value_type": "STRING", "string_value": "消防应急广播系统的保养操作保养完成后，对消防应急广播系统进行复位和自检操作，观察消防应急广播系统是否处于正常监视状态。"}, {"row": 210, "col": 0, "value_type": "NUMBER", "number_value": 210}, {"row": 210, "col": 1, "value_type": "STRING", "string_value": "消防应急广播声压级的保养要求为：距扬声器正前方3m处，用数字声级计测量应急广播声压级（A权计）不应小于70dB，且不应大于115dB。（  ）"}, {"row": 210, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 210, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 210, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 210, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 210, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 210, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 210, "col": 8, "value_type": "STRING", "string_value": "消防应急广播声压级的保养要求为：距扬声器正前方3m处，用数字声级计测量应急广播声压级（A权计）不应小于65dB，且不应大于115dB。"}, {"row": 211, "col": 0, "value_type": "NUMBER", "number_value": 211}, {"row": 211, "col": 1, "value_type": "STRING", "string_value": "消防设备末端配电装置的清扫和检修一般每年至少一次。（  ）"}, {"row": 211, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 211, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 211, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 211, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 211, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 211, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 211, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 212, "col": 0, "value_type": "NUMBER", "number_value": 212}, {"row": 212, "col": 1, "value_type": "STRING", "string_value": "消防设备末端配电装置保养操作时，用湿布清洁装置外壳表面，去除污渍、灰尘，并保证指示灯、显示屏清晰可见。（  ）"}, {"row": 212, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 212, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 212, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 212, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 212, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 212, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 212, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 213, "col": 0, "value_type": "NUMBER", "number_value": 213}, {"row": 213, "col": 1, "value_type": "STRING", "string_value": "使用螺丝刀调整机械式压力开关的两个调节螺钉的调整方式为精确调整。（  ）"}, {"row": 213, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 213, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 213, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 213, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 213, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 213, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 213, "col": 8, "value_type": "STRING", "string_value": "机械式压力开关调整：如下图所示，该型压力开关具有两个调节螺钉，使用螺丝刀调节压力调整螺钉时，压力开关观察窗中RANGE（控压范围）对应的指针能够上下移动，并结合当前所示刻度可以大致设定受控设备动作压力。使用螺丝刀调节压差调整螺钉时，压力开关观察窗中DIFF（切换差，即死区）对应的指针能够上下移动，并结合当前所示刻度可以大致设定受控设备启停控制的压力差值。需要说明的是，该种调整方式只是粗调，在有条件的情况下应当使用专用工作台进行精确调整设定。"}, {"row": 214, "col": 0, "value_type": "NUMBER", "number_value": 214}, {"row": 214, "col": 1, "value_type": "STRING", "string_value": "防烟排烟系统的风机保养要求之一是铭牌清晰。（  ）"}, {"row": 214, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 214, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 214, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 214, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 214, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 214, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 214, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 215, "col": 0, "value_type": "NUMBER", "number_value": 215}, {"row": 215, "col": 1, "value_type": "STRING", "string_value": "防（排）烟风机保养操作时，应连续运转1~3min,验证风机运转正常。（  ）"}, {"row": 215, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 215, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 215, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 215, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 215, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 215, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 215, "col": 8, "value_type": "STRING", "string_value": "连续运转5~7min,验证风机运转正常。"}, {"row": 216, "col": 0, "value_type": "NUMBER", "number_value": 216}, {"row": 216, "col": 1, "value_type": "STRING", "string_value": "对干式自动喷水灭火系统中的水流指示器的保养要求是：外观完好，标识明显，水流指示器的启动与复位灵敏、可靠，反馈信号准确。（  ）"}, {"row": 216, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 216, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 216, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 216, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 216, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 216, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 216, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 217, "col": 0, "value_type": "NUMBER", "number_value": 217}, {"row": 217, "col": 1, "value_type": "STRING", "string_value": "电气火灾监控器的显示屏有显示不正常的问题应及时修复。（  ）"}, {"row": 217, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 217, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 217, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 217, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 217, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 217, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 217, "col": 8, "value_type": "STRING", "string_value": "电气火灾监控器的指示灯或显示屏保养方法：（1）指示灯和显示屏表面应用湿布擦拭干净（2）出现指示灯无规则闪烁故障或损坏应及时更换（3）如显示屏有显示不正常的问题应及时修复。"}, {"row": 218, "col": 0, "value_type": "NUMBER", "number_value": 218}, {"row": 218, "col": 1, "value_type": "STRING", "string_value": "电气火灾监控器保养工作完成后，应将设备恢复到正常工作状态。（  ）"}, {"row": 218, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 218, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 218, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 218, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 218, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 218, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 218, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 219, "col": 0, "value_type": "NUMBER", "number_value": 219}, {"row": 219, "col": 1, "value_type": "STRING", "string_value": "保养消防控制室图形显示装置的显示屏表面时，应用湿布擦拭清洁干净。（  ）"}, {"row": 219, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 219, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 219, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 219, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 219, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 219, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 219, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 220, "col": 0, "value_type": "NUMBER", "number_value": 220}, {"row": 220, "col": 1, "value_type": "STRING", "string_value": "保养消防电话系统的按键时，保养方法为：对所有按键进行按下、弹起操作。（  ）"}, {"row": 220, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 220, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 220, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 220, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 220, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 220, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 220, "col": 8, "value_type": "STRING", "string_value": "暂无解析"}, {"row": 221, "col": 0, "value_type": "NUMBER", "number_value": 221}, {"row": 221, "col": 1, "value_type": "STRING", "string_value": "消火栓按钮启动后不报警的原因可能为消防泵组电气控制柜处于手动状态。（  ）"}, {"row": 221, "col": 2, "value_type": "STRING", "string_value": "正确"}, {"row": 221, "col": 3, "value_type": "STRING", "string_value": "错误"}, {"row": 221, "col": 4, "value_type": "STRING", "string_value": ""}, {"row": 221, "col": 5, "value_type": "STRING", "string_value": ""}, {"row": 221, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 221, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 221, "col": 8, "value_type": "STRING", "string_value": "消火栓按钮启动后不报警的原因：（1）消火栓按钮损坏（2）线路损坏。消防泵组电气控制柜处于手动状态是不启泵的原因。"}, {"row": 222, "col": 0, "value_type": "NUMBER", "number_value": 222}, {"row": 222, "col": 1, "value_type": "STRING", "string_value": "消防应急广播控制器音源文件丢失的修复方法为：重新导入应急广播的音源文件。（  ）"}]