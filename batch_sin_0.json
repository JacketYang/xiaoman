[{"row": 0, "col": 0, "value_type": "STRING", "string_value": "题号"}, {"row": 0, "col": 1, "value_type": "STRING", "string_value": "题目"}, {"row": 0, "col": 2, "value_type": "STRING", "string_value": "选项A"}, {"row": 0, "col": 3, "value_type": "STRING", "string_value": "选项B"}, {"row": 0, "col": 4, "value_type": "STRING", "string_value": "选项C"}, {"row": 0, "col": 5, "value_type": "STRING", "string_value": "选项D"}, {"row": 0, "col": 6, "value_type": "STRING", "string_value": "选项E"}, {"row": 0, "col": 7, "value_type": "STRING", "string_value": "答案"}, {"row": 0, "col": 8, "value_type": "STRING", "string_value": "解析"}, {"row": 1, "col": 0, "value_type": "NUMBER", "number_value": 408}, {"row": 1, "col": 1, "value_type": "STRING", "string_value": "下列不属于消防设施操作员的主要工作任务的是（  ）。"}, {"row": 1, "col": 2, "value_type": "STRING", "string_value": "值守消防控制室"}, {"row": 1, "col": 3, "value_type": "STRING", "string_value": "组织编写消防应急预案及演练工作"}, {"row": 1, "col": 4, "value_type": "STRING", "string_value": "检测火灾自动报警、自动灭火系统等消防设施"}, {"row": 1, "col": 5, "value_type": "STRING", "string_value": "操作、维修保养火灾自动报警、自动灭火系统等消防设施"}, {"row": 1, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 1, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 1, "col": 8, "value_type": "STRING", "string_value": "消防设施操作员主要工作任务有三项：一是值守消防控制室；二是操作、维修保养火灾自动报警、自动灭火系统等消防设施；三是检测火灾自动报警、自动灭火系统等消防设施。"}, {"row": 2, "col": 0, "value_type": "NUMBER", "number_value": 409}, {"row": 2, "col": 1, "value_type": "STRING", "string_value": "消防设施操作员指的是从事建（构）筑物消防设施运行、操作和（  ）等工作的人员。"}, {"row": 2, "col": 2, "value_type": "STRING", "string_value": "检测"}, {"row": 2, "col": 3, "value_type": "STRING", "string_value": "维修"}, {"row": 2, "col": 4, "value_type": "STRING", "string_value": "保养"}, {"row": 2, "col": 5, "value_type": "STRING", "string_value": "以上全部"}, {"row": 2, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 2, "col": 7, "value_type": "STRING", "string_value": "D"}, {"row": 2, "col": 8, "value_type": "STRING", "string_value": "消防设施操作员职业定义为：从事建（构）筑物消防设施运行、操作和维修、保养、检测等工作的人员。"}, {"row": 3, "col": 0, "value_type": "NUMBER", "number_value": 410}, {"row": 3, "col": 1, "value_type": "STRING", "string_value": "（  ）是每个人、每个单位和全社会的事，这就要求牢固树立安全发展理念，弘扬生命至上、安全第一的思想。"}, {"row": 3, "col": 2, "value_type": "STRING", "string_value": "消防安全"}, {"row": 3, "col": 3, "value_type": "STRING", "string_value": "生命安全"}, {"row": 3, "col": 4, "value_type": "STRING", "string_value": "火灾预防"}, {"row": 3, "col": 5, "value_type": "STRING", "string_value": "生命财产"}, {"row": 3, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 3, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 3, "col": 8, "value_type": "STRING", "string_value": "消防安全是每个人、每个单位和全社会的事，这就要求牢固树立安全发展理念，弘扬生命至上、安全第一的思想，把发展不能以牺牲人的生命为代价作为不可逾越的红线，以“安全第一”的价值观作为行动指南，坚决遏制重特大消防安全事故。"}, {"row": 4, "col": 0, "value_type": "NUMBER", "number_value": 411}, {"row": 4, "col": 1, "value_type": "STRING", "string_value": "职业必须具有一定的从业人数，属于职业特征的（  ）。"}, {"row": 4, "col": 2, "value_type": "STRING", "string_value": "规范性"}, {"row": 4, "col": 3, "value_type": "STRING", "string_value": "社会性"}, {"row": 4, "col": 4, "value_type": "STRING", "string_value": "稳定性"}, {"row": 4, "col": 5, "value_type": "STRING", "string_value": "群体性"}, {"row": 4, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 4, "col": 7, "value_type": "STRING", "string_value": "D"}, {"row": 4, "col": 8, "value_type": "STRING", "string_value": "职业需具备下列特征：1）目的性。即职业活动以获得现金或实物等报酬为目的。2）社会性。即职业是从业人员在特定社会生活环境中所从事的一种与其他社会成员相互关联、相互服务的社会活动。3）稳定性。即职业在一定的历史时期内形成，并具有较长生命周期。4）规范性。即职业活动必须符合国家法律和社会道德规范。5）群体性。即职业必须具有一定的从业人数。"}, {"row": 5, "col": 0, "value_type": "NUMBER", "number_value": 412}, {"row": 5, "col": 1, "value_type": "STRING", "string_value": "每一名消防设施操作员都必须把人民群众的（  ）作为一切工作的出发点和落脚点，从人权观、发展观、人本观的高度，认识生命与健康的价值，始终坚守消防安全红线。"}, {"row": 5, "col": 2, "value_type": "STRING", "string_value": "消防安全"}, {"row": 5, "col": 3, "value_type": "STRING", "string_value": "生命安全"}, {"row": 5, "col": 4, "value_type": "STRING", "string_value": "火灾预防"}, {"row": 5, "col": 5, "value_type": "STRING", "string_value": "生命财产"}, {"row": 5, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 5, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 5, "col": 8, "value_type": "STRING", "string_value": "每一名消防设施操作员都必须把人民群众的生命安全作为一切工作的出发点和落脚点，从人权观、发展观、人本观的高度，认识生命与健康的价值，始终坚守消防安全红线。"}, {"row": 6, "col": 0, "value_type": "NUMBER", "number_value": 413}, {"row": 6, "col": 1, "value_type": "STRING", "string_value": "职业活动必须符合国家法律和社会道德规范，属于职业特征的（  ）。"}, {"row": 6, "col": 2, "value_type": "STRING", "string_value": "目的性"}, {"row": 6, "col": 3, "value_type": "STRING", "string_value": "社会性"}, {"row": 6, "col": 4, "value_type": "STRING", "string_value": "稳定性"}, {"row": 6, "col": 5, "value_type": "STRING", "string_value": "规范性"}, {"row": 6, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 6, "col": 7, "value_type": "STRING", "string_value": "D"}, {"row": 6, "col": 8, "value_type": "STRING", "string_value": "职业需具备下列特征：1）目的性。即职业活动以获得现金或实物等报酬为目的。2）社会性。即职业是从业人员在特定社会生活环境中所从事的一种与其他社会成员相互关联、相互服务的社会活动。3）稳定性。即职业在一定的历史时期内形成，并具有较长生命周期。4）规范性。即职业活动必须符合国家法律和社会道德规范。5）群体性。即职业必须具有一定的从业人数。"}, {"row": 7, "col": 0, "value_type": "NUMBER", "number_value": 414}, {"row": 7, "col": 1, "value_type": "STRING", "string_value": "职业在一定的历史时期内形成，并具有较长生命周期，属于职业特征的（  ）。"}, {"row": 7, "col": 2, "value_type": "STRING", "string_value": "目的性"}, {"row": 7, "col": 3, "value_type": "STRING", "string_value": "社会性"}, {"row": 7, "col": 4, "value_type": "STRING", "string_value": "稳定性"}, {"row": 7, "col": 5, "value_type": "STRING", "string_value": "规范性"}, {"row": 7, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 7, "col": 7, "value_type": "STRING", "string_value": "C"}, {"row": 7, "col": 8, "value_type": "STRING", "string_value": "职业需具备下列特征：1）目的性。即职业活动以获得现金或实物等报酬为目的。2）社会性。即职业是从业人员在特定社会生活环境中所从事的一种与其他社会成员相互关联、相互服务的社会活动。3）稳定性。即职业在一定的历史时期内形成，并具有较长生命周期。4）规范性。即职业活动必须符合国家法律和社会道德规范。5）群体性。即职业必须具有一定的从业人数。"}, {"row": 8, "col": 0, "value_type": "NUMBER", "number_value": 415}, {"row": 8, "col": 1, "value_type": "STRING", "string_value": "从消防工作来说，坚持（  ）就是要充分尊重和切实保障人民群众的生命权、财产权等法定权利，努力满足人民群众日益增长的消防安全需求。"}, {"row": 8, "col": 2, "value_type": "STRING", "string_value": "以人为本"}, {"row": 8, "col": 3, "value_type": "STRING", "string_value": "生命至上"}, {"row": 8, "col": 4, "value_type": "STRING", "string_value": "忠于职守"}, {"row": 8, "col": 5, "value_type": "STRING", "string_value": "严守规程"}, {"row": 8, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 8, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 8, "col": 8, "value_type": "STRING", "string_value": "从消防工作来说，坚持以人为本就是要充分尊重和切实保障人民群众的生命权、财产权等法定权利，努力满足人民群众日益增长的消防安全需求。"}, {"row": 9, "col": 0, "value_type": "NUMBER", "number_value": 416}, {"row": 9, "col": 1, "value_type": "STRING", "string_value": "职业是从业人员在特定社会生活环境中所从事的一种与其他社会成员相互关联、相互服务的社会活动，属于职业特征的（  ）。"}, {"row": 9, "col": 2, "value_type": "STRING", "string_value": "目的性"}, {"row": 9, "col": 3, "value_type": "STRING", "string_value": "社会性"}, {"row": 9, "col": 4, "value_type": "STRING", "string_value": "稳定性"}, {"row": 9, "col": 5, "value_type": "STRING", "string_value": "规范性"}, {"row": 9, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 9, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 9, "col": 8, "value_type": "STRING", "string_value": "职业需具备下列特征：1）目的性。即职业活动以获得现金或实物等报酬为目的。2）社会性。即职业是从业人员在特定社会生活环境中所从事的一种与其他社会成员相互关联、相互服务的社会活动。3）稳定性。即职业在一定的历史时期内形成，并具有较长生命周期。4）规范性。即职业活动必须符合国家法律和社会道德规范。5）群体性。即职业必须具有一定的从业人数。"}, {"row": 10, "col": 0, "value_type": "NUMBER", "number_value": 417}, {"row": 10, "col": 1, "value_type": "STRING", "string_value": "下列不属于消防行业职业道德的作用的是（  ）。"}, {"row": 10, "col": 2, "value_type": "STRING", "string_value": "调节消防行业从业人员内部的关系"}, {"row": 10, "col": 3, "value_type": "STRING", "string_value": "调节消防设施操作员和服务单位之间的关系"}, {"row": 10, "col": 4, "value_type": "STRING", "string_value": "有利于促进社会良好道德风尚的形成"}, {"row": 10, "col": 5, "value_type": "STRING", "string_value": "不断提高自身的职业技能和单位的火灾防控能力"}, {"row": 10, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 10, "col": 7, "value_type": "STRING", "string_value": "D"}, {"row": 10, "col": 8, "value_type": "STRING", "string_value": "不断提高自身的职业技能和单位的火灾防控能力属于消防行业职业道德的特点。"}, {"row": 11, "col": 0, "value_type": "NUMBER", "number_value": 418}, {"row": 11, "col": 1, "value_type": "STRING", "string_value": "科学处置是指以减少火灾危害为前提，科学合理地选择有（  ）的火灾处置措施，妥善处理各种险情。"}, {"row": 11, "col": 2, "value_type": "STRING", "string_value": "指导性"}, {"row": 11, "col": 3, "value_type": "STRING", "string_value": "针对性"}, {"row": 11, "col": 4, "value_type": "STRING", "string_value": "约束性"}, {"row": 11, "col": 5, "value_type": "STRING", "string_value": "预防性"}, {"row": 11, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 11, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 11, "col": 8, "value_type": "STRING", "string_value": "科学处置是指以减少火灾危害为前提，科学合理地选择有针对性的火灾处置措施，妥善处理各种险情。"}, {"row": 12, "col": 0, "value_type": "NUMBER", "number_value": 419}, {"row": 12, "col": 1, "value_type": "STRING", "string_value": "（  ）是评价消防设施操作员职业行为好坏的标准，能够促使本人尽最大的能力把工作做好，树立良好的行业信誉"}, {"row": 12, "col": 2, "value_type": "STRING", "string_value": "消防行业职业道德"}, {"row": 12, "col": 3, "value_type": "STRING", "string_value": "国家职业技能标准"}, {"row": 12, "col": 4, "value_type": "STRING", "string_value": "职业的社会属性"}, {"row": 12, "col": 5, "value_type": "STRING", "string_value": "职业的规范性"}, {"row": 12, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 12, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 12, "col": 8, "value_type": "STRING", "string_value": "消防行业职业道德是评价消防设施操作员职业行为好坏的标准，能够促使本人尽最大的能力把工作做好，树立良好的行业信誉。"}, {"row": 13, "col": 0, "value_type": "NUMBER", "number_value": 420}, {"row": 13, "col": 1, "value_type": "STRING", "string_value": "下列不属于消防行业职业道德的特点的是（  ）。"}, {"row": 13, "col": 2, "value_type": "STRING", "string_value": "消防安全的责任性"}, {"row": 13, "col": 3, "value_type": "STRING", "string_value": "职业行为的指导性"}, {"row": 13, "col": 4, "value_type": "STRING", "string_value": "表现形式的多样性"}, {"row": 13, "col": 5, "value_type": "STRING", "string_value": "规范从业的约束性"}, {"row": 13, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 13, "col": 7, "value_type": "STRING", "string_value": "C"}, {"row": 13, "col": 8, "value_type": "STRING", "string_value": "消防行业职业道德的特点：消防安全的责任性、工作标准的原则性、职业行为的指导性、规范从业的约束性。表现形式的多样性属于职业道德的特征"}, {"row": 14, "col": 0, "value_type": "NUMBER", "number_value": 421}, {"row": 14, "col": 1, "value_type": "STRING", "string_value": "临危不乱是消防设施操作员应该具备的最基本的（  ）。"}, {"row": 14, "col": 2, "value_type": "STRING", "string_value": "安全意识"}, {"row": 14, "col": 3, "value_type": "STRING", "string_value": "职业素质"}, {"row": 14, "col": 4, "value_type": "STRING", "string_value": "心理素质"}, {"row": 14, "col": 5, "value_type": "STRING", "string_value": "责任意识"}, {"row": 14, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 14, "col": 7, "value_type": "STRING", "string_value": "C"}, {"row": 14, "col": 8, "value_type": "STRING", "string_value": "临危不乱是消防设施操作员应该具备的最基本的心理素质。"}, {"row": 15, "col": 0, "value_type": "NUMBER", "number_value": 422}, {"row": 15, "col": 1, "value_type": "STRING", "string_value": "积极自觉地为社会作贡献是指的职业道德基本规范中的（  ）。"}, {"row": 15, "col": 2, "value_type": "STRING", "string_value": "诚实守信"}, {"row": 15, "col": 3, "value_type": "STRING", "string_value": "办事公道"}, {"row": 15, "col": 4, "value_type": "STRING", "string_value": "奉献社会"}, {"row": 15, "col": 5, "value_type": "STRING", "string_value": "服务群众"}, {"row": 15, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 15, "col": 7, "value_type": "STRING", "string_value": "C"}, {"row": 15, "col": 8, "value_type": "STRING", "string_value": "奉献社会。奉献社会就是积极自觉地为社会做贡献。"}, {"row": 16, "col": 0, "value_type": "NUMBER", "number_value": 423}, {"row": 16, "col": 1, "value_type": "STRING", "string_value": "（  ）是指在遇到紧急情况时，可以先于他人意识到危险的存在，知道解决的方法，心情不慌乱，能够从容应对。"}, {"row": 16, "col": 2, "value_type": "STRING", "string_value": "临危不乱"}, {"row": 16, "col": 3, "value_type": "STRING", "string_value": "精益求精"}, {"row": 16, "col": 4, "value_type": "STRING", "string_value": "严守规程"}, {"row": 16, "col": 5, "value_type": "STRING", "string_value": "科学处置"}, {"row": 16, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 16, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 16, "col": 8, "value_type": "STRING", "string_value": "临危不乱是指在遇到紧急情况时，可以先于他人意识到危险的存在，知道解决的方法，心情不慌乱，能够从容应对。"}, {"row": 17, "col": 0, "value_type": "NUMBER", "number_value": 424}, {"row": 17, "col": 1, "value_type": "STRING", "string_value": "（  ）作为最基本的职业道德规范，是对人们工作态度的一种普遍要求，是中华民族传统美德和现代企业发展的要求。"}, {"row": 17, "col": 2, "value_type": "STRING", "string_value": "爱岗敬业"}, {"row": 17, "col": 3, "value_type": "STRING", "string_value": "诚实守信"}, {"row": 17, "col": 4, "value_type": "STRING", "string_value": "办事公道"}, {"row": 17, "col": 5, "value_type": "STRING", "string_value": "奉献社会"}, {"row": 17, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 17, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 17, "col": 8, "value_type": "STRING", "string_value": "爱岗敬业。爱岗敬业作为最基本的职业道德规范，是对人们工作态度的一种普遍要求，是中华民族传统美德和现代企业发展的要求。爱岗就是热爱自己的工作岗位、热爱本职工作，敬业就是要用一种恭敬严肃的态度对待自己的工作。"}, {"row": 18, "col": 0, "value_type": "NUMBER", "number_value": 425}, {"row": 18, "col": 1, "value_type": "STRING", "string_value": "追求精益求精的“（  ）”是踏实肯干的工作心态，不畏艰难的工作精神，勇于攀登的工作激情，核心是坚持不懈和精益求精。"}, {"row": 18, "col": 2, "value_type": "STRING", "string_value": "创新精神"}, {"row": 18, "col": 3, "value_type": "STRING", "string_value": "专业精神"}, {"row": 18, "col": 4, "value_type": "STRING", "string_value": "工匠精神"}, {"row": 18, "col": 5, "value_type": "STRING", "string_value": "学习精神"}, {"row": 18, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 18, "col": 7, "value_type": "STRING", "string_value": "C"}, {"row": 18, "col": 8, "value_type": "STRING", "string_value": "追求精益求精的“工匠精神”。“工匠精神”是踏实肯干的工作心态，不畏艰难的工作精神，勇于攀登的工作激情，核心是坚持不懈和精益求精。"}, {"row": 19, "col": 0, "value_type": "NUMBER", "number_value": 426}, {"row": 19, "col": 1, "value_type": "STRING", "string_value": "精益求精是指为了（  ），坚持工匠精神，在工作中不放松对自己的要求。"}, {"row": 19, "col": 2, "value_type": "STRING", "string_value": "人生理想"}, {"row": 19, "col": 3, "value_type": "STRING", "string_value": "技术能力"}, {"row": 19, "col": 4, "value_type": "STRING", "string_value": "苦练技能"}, {"row": 19, "col": 5, "value_type": "STRING", "string_value": "追求完美"}, {"row": 19, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 19, "col": 7, "value_type": "STRING", "string_value": "D"}, {"row": 19, "col": 8, "value_type": "STRING", "string_value": "精益求精是指为了追求完美，坚持工匠精神，在工作中不放松对自己的要求。"}, {"row": 20, "col": 0, "value_type": "NUMBER", "number_value": 427}, {"row": 20, "col": 1, "value_type": "STRING", "string_value": "职业活动以获得现金或实物等报酬为目的，属于职业特征的。（  ）"}, {"row": 20, "col": 2, "value_type": "STRING", "string_value": "目的性"}, {"row": 20, "col": 3, "value_type": "STRING", "string_value": "社会性"}, {"row": 20, "col": 4, "value_type": "STRING", "string_value": "稳定性"}, {"row": 20, "col": 5, "value_type": "STRING", "string_value": "规范性"}, {"row": 20, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 20, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 20, "col": 8, "value_type": "STRING", "string_value": "职业需具备下列特征：1）目的性。即职业活动以获得现金或实物等报酬为目的。2）社会性。即职业是从业人员在特定社会生活环境中所从事的一种与其他社会成员相互关联、相互服务的社会活动。3）稳定性。即职业在一定的历史时期内形成，并具有较长生命周期。4）规范性。即职业活动必须符合国家法律和社会道德规范。5）群体性。即职业必须具有一定的从业人数。"}, {"row": 21, "col": 0, "value_type": "NUMBER", "number_value": 428}, {"row": 21, "col": 1, "value_type": "STRING", "string_value": "消防设施操作员职业守则的内容不包含（  ）。"}, {"row": 21, "col": 2, "value_type": "STRING", "string_value": "以人为本，生命至上"}, {"row": 21, "col": 3, "value_type": "STRING", "string_value": "忠于职守，严守规程"}, {"row": 21, "col": 4, "value_type": "STRING", "string_value": "钻研业务，精益求精"}, {"row": 21, "col": 5, "value_type": "STRING", "string_value": "预防为主，防消结合"}, {"row": 21, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 21, "col": 7, "value_type": "STRING", "string_value": "D"}, {"row": 21, "col": 8, "value_type": "STRING", "string_value": "消防设操作员职业守则的内容是:以人为本，生命至上；忠于职守，严守规程；钻研业务，精益求精；临危不乱，科学处置。"}, {"row": 22, "col": 0, "value_type": "NUMBER", "number_value": 429}, {"row": 22, "col": 1, "value_type": "STRING", "string_value": "职业作风是从业者在职业活动中表现出来的相对稳定的工作态度和职业风范。下列从业者在职业岗位中的表现不属于职业作风的有（  ）。"}, {"row": 22, "col": 2, "value_type": "STRING", "string_value": "尽职尽责"}, {"row": 22, "col": 3, "value_type": "STRING", "string_value": "诚实守信"}, {"row": 22, "col": 4, "value_type": "STRING", "string_value": "奋力拼搏"}, {"row": 22, "col": 5, "value_type": "STRING", "string_value": "诚实无欺"}, {"row": 22, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 22, "col": 7, "value_type": "STRING", "string_value": "D"}, {"row": 22, "col": 8, "value_type": "STRING", "string_value": "职业作风是从业者在职业活动中表现出来的相对稳定的工作态度和职业风范。从业者在职业岗位中表现出来的尽职尽责、诚实守信、奋力拼搏、艰苦奋斗的作风等，都属于职业作风。诚实无欺属于职业良心"}, {"row": 23, "col": 0, "value_type": "NUMBER", "number_value": 430}, {"row": 23, "col": 1, "value_type": "STRING", "string_value": "树立（  ）的理念是指把学习作为人生永恒的追求，树立和践行终身学习观，不断拓宽知识面，更新知识结构，用正确、科学的方法将工作做到尽善尽美。"}, {"row": 23, "col": 2, "value_type": "STRING", "string_value": "爱岗敬业"}, {"row": 23, "col": 3, "value_type": "STRING", "string_value": "终身学习"}, {"row": 23, "col": 4, "value_type": "STRING", "string_value": "遵纪守法"}, {"row": 23, "col": 5, "value_type": "STRING", "string_value": "严于律己"}, {"row": 23, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 23, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 23, "col": 8, "value_type": "STRING", "string_value": "树立终身学习的理念。要把学习作为人生永恒的追求，树立和践行终身学习观，不断拓宽知识面，更新知识结构，用正确、科学的方法将工作做到尽善尽美，胜任消防技术岗位的工作"}, {"row": 24, "col": 0, "value_type": "NUMBER", "number_value": 431}, {"row": 24, "col": 1, "value_type": "STRING", "string_value": "当一个从业者职业行为的社会价值赢得社会公认时，就会由此产生荣誉感；反之，会产生耻辱感。指的是职业道德基本要素中的（  ）。"}, {"row": 24, "col": 2, "value_type": "STRING", "string_value": "职业态度"}, {"row": 24, "col": 3, "value_type": "STRING", "string_value": "职业荣誉"}, {"row": 24, "col": 4, "value_type": "STRING", "string_value": "职业纪律"}, {"row": 24, "col": 5, "value_type": "STRING", "string_value": "职业良心"}, {"row": 24, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 24, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 24, "col": 8, "value_type": "STRING", "string_value": "职业荣誉。职业荣誉是社会对从业者职业道德活动的价值所做出的褒奖和肯定评价，以及从业者在主观认识上对自己职业道德活动的一种自尊、自爱的荣辱意向。当一个从业者职业行为的社会价值赢得社会公认时，就会由此产生荣誉感；反之，会产生耻辱感。"}, {"row": 25, "col": 0, "value_type": "NUMBER", "number_value": 432}, {"row": 25, "col": 1, "value_type": "STRING", "string_value": "不论是成就自己的人生理想，还是担负时代的神圣使命，都应深人学习更高层次和更广泛的知识，努力做到“（  ）”与“博”的统一。"}, {"row": 25, "col": 2, "value_type": "STRING", "string_value": "精"}, {"row": 25, "col": 3, "value_type": "STRING", "string_value": "钻"}, {"row": 25, "col": 4, "value_type": "STRING", "string_value": "专"}, {"row": 25, "col": 5, "value_type": "STRING", "string_value": "遵"}, {"row": 25, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 25, "col": 7, "value_type": "STRING", "string_value": "C"}, {"row": 25, "col": 8, "value_type": "STRING", "string_value": "不论是成就自己的人生理想，还是担负时代的神圣使命，都应深人学习更高层次和更广泛的知识，努力做到“专”与“博”的统一。"}, {"row": 26, "col": 0, "value_type": "NUMBER", "number_value": 433}, {"row": 26, "col": 1, "value_type": "STRING", "string_value": "下列要求中不属于不断提高自身的综合素质的是（  ）。"}, {"row": 26, "col": 2, "value_type": "STRING", "string_value": "具备丰富的理论知识"}, {"row": 26, "col": 3, "value_type": "STRING", "string_value": "具备较强的实操能力"}, {"row": 26, "col": 4, "value_type": "STRING", "string_value": "具备解决复杂问题的能力"}, {"row": 26, "col": 5, "value_type": "STRING", "string_value": "干一行爱一行"}, {"row": 26, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 26, "col": 7, "value_type": "STRING", "string_value": "D"}, {"row": 26, "col": 8, "value_type": "STRING", "string_value": "不断提高自身的综合素质。一个人综合素质的高低，对做好本职工作起着决定性的作用。消防设施操作员是技术技能型人才，要具备丰富的理论知识、较强的实操能力，以及解决复杂问题的能力。因此，要树立明确的学习目标，持之以恒，苦练基本功，提高职业技能和专业技术能力，以适应工作需要。“干一行爱一行、专一行精一行”是追求完美的工作表现。"}, {"row": 27, "col": 0, "value_type": "NUMBER", "number_value": 434}, {"row": 27, "col": 1, "value_type": "STRING", "string_value": "（  ）从业者在岗位工作中必须遵守的规章、制度、条例等职业行为规范。"}, {"row": 27, "col": 2, "value_type": "STRING", "string_value": "职业良心"}, {"row": 27, "col": 3, "value_type": "STRING", "string_value": "职业义务"}, {"row": 27, "col": 4, "value_type": "STRING", "string_value": "职业纪律"}, {"row": 27, "col": 5, "value_type": "STRING", "string_value": "职业作风"}, {"row": 27, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 27, "col": 7, "value_type": "STRING", "string_value": "C"}, {"row": 27, "col": 8, "value_type": "STRING", "string_value": "职业纪律。职业纪律是从业者在岗位工作中必须遵守的规章、制度、条例等职业行为规范。例如，国家公务员必须廉洁奉公、甘当公仆，公安、司法人员必须秉公执法、铁面无私等。这些规定和纪律要求，都是从业者做好本职工作的必要条件。"}, {"row": 28, "col": 0, "value_type": "NUMBER", "number_value": 435}, {"row": 28, "col": 1, "value_type": "STRING", "string_value": "（  ）指在消防从业中刻苦钻研，深人探究并掌握火灾发生、发展的规律，以及防火、灭火的知识和技能。"}, {"row": 28, "col": 2, "value_type": "STRING", "string_value": "忠于职守"}, {"row": 28, "col": 3, "value_type": "STRING", "string_value": "刻苦学习"}, {"row": 28, "col": 4, "value_type": "STRING", "string_value": "精益求精"}, {"row": 28, "col": 5, "value_type": "STRING", "string_value": "钻研业务"}, {"row": 28, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 28, "col": 7, "value_type": "STRING", "string_value": "D"}, {"row": 28, "col": 8, "value_type": "STRING", "string_value": "钻研业务是指在消防从业中刻苦钻研，深人探究并掌握火灾发生、发展的规律，以及防火、灭火的知识和技能。"}, {"row": 29, "col": 0, "value_type": "NUMBER", "number_value": 436}, {"row": 29, "col": 1, "value_type": "STRING", "string_value": "根据道德的表现形式，人们通常把道德分为家庭美德、社会公德和（  ）三大领域。"}, {"row": 29, "col": 2, "value_type": "STRING", "string_value": "职业道德"}, {"row": 29, "col": 3, "value_type": "STRING", "string_value": "品德教育"}, {"row": 29, "col": 4, "value_type": "STRING", "string_value": "安全教育"}, {"row": 29, "col": 5, "value_type": "STRING", "string_value": "法律教育"}, {"row": 29, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 29, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 29, "col": 8, "value_type": "STRING", "string_value": "根据道德的表现形式，人们通常把道德分为家庭美德、社会公德和职业道德三大领域。"}, {"row": 30, "col": 0, "value_type": "NUMBER", "number_value": 437}, {"row": 30, "col": 1, "value_type": "STRING", "string_value": "下列描述中不符合《消防设施操作员国家职业技能标准》的是（  ）。"}, {"row": 30, "col": 2, "value_type": "STRING", "string_value": "该标准的指导思想为“职业活动为导向、职业技能为核心”"}, {"row": 30, "col": 3, "value_type": "STRING", "string_value": "该标准包括职业概况、基本要求、工作要求和权重表四个方面的内容"}, {"row": 30, "col": 4, "value_type": "STRING", "string_value": "该标准含有设施监控、设施操作、设施保养、设施维修、设施检测、技术管理和培训六个职业功能"}, {"row": 30, "col": 5, "value_type": "STRING", "string_value": "消防设施监控操作职业方向分别为四级/中级工、三级/高级工、二级/技师、一级/高级技师"}, {"row": 30, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 30, "col": 7, "value_type": "STRING", "string_value": "D"}, {"row": 30, "col": 8, "value_type": "STRING", "string_value": "消防设施操作员国家职业技能标准中将本职业共设五个等级，其中，消防设施监控操作职业方向分别为五级/初级工、四级/中级工、三级/高级工、二级/技师，消防设施检测维修保养职业方向分别为四级/中级工、三级/高级工、二级/技师、一级/高级技师。"}, {"row": 31, "col": 0, "value_type": "NUMBER", "number_value": 438}, {"row": 31, "col": 1, "value_type": "STRING", "string_value": "（  ）是指以强烈的责任心、敢于担当的使命感，把本职工作做好做细。"}, {"row": 31, "col": 2, "value_type": "STRING", "string_value": "责任担当"}, {"row": 31, "col": 3, "value_type": "STRING", "string_value": "爱岗敬业"}, {"row": 31, "col": 4, "value_type": "STRING", "string_value": "忠于职守"}, {"row": 31, "col": 5, "value_type": "STRING", "string_value": "认真工作"}, {"row": 31, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 31, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 31, "col": 8, "value_type": "STRING", "string_value": "责任担当。以强烈的责任心、敢于担当的使命感，把本职工作做好做细。"}, {"row": 32, "col": 0, "value_type": "NUMBER", "number_value": 439}, {"row": 32, "col": 1, "value_type": "STRING", "string_value": "消防设施操作员国家职业技能标准于(  )颁布，自2020年1月1日起实施。"}, {"row": 32, "col": 2, "value_type": "STRING", "string_value": "2019年4月"}, {"row": 32, "col": 3, "value_type": "STRING", "string_value": "2019年5月"}, {"row": 32, "col": 4, "value_type": "STRING", "string_value": "2019年6月"}, {"row": 32, "col": 5, "value_type": "STRING", "string_value": "2019年7月"}, {"row": 32, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 32, "col": 7, "value_type": "STRING", "string_value": "C"}, {"row": 32, "col": 8, "value_type": "STRING", "string_value": "消防设施操作员国家职业技能标准于2019年6月颁布，自2020年1月1日起实施。"}, {"row": 33, "col": 0, "value_type": "NUMBER", "number_value": 440}, {"row": 33, "col": 1, "value_type": "STRING", "string_value": "（  ）是指以高度负责的职业道德精神，在本岗位上尽职尽责，时刻做好为消防事业献出生命的准备。"}, {"row": 33, "col": 2, "value_type": "STRING", "string_value": "生命至上"}, {"row": 33, "col": 3, "value_type": "STRING", "string_value": "以人为本"}, {"row": 33, "col": 4, "value_type": "STRING", "string_value": "安全第一"}, {"row": 33, "col": 5, "value_type": "STRING", "string_value": "忠于职守"}, {"row": 33, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 33, "col": 7, "value_type": "STRING", "string_value": "D"}, {"row": 33, "col": 8, "value_type": "STRING", "string_value": "忠于职守是指以高度负责的职业道德精神，在本岗位上尽职尽责，时刻做好为消防事业献出生命的准备。"}, {"row": 34, "col": 0, "value_type": "NUMBER", "number_value": 441}, {"row": 34, "col": 1, "value_type": "STRING", "string_value": "（  ）是员工在生产经营活动中恪守的行为规范。"}, {"row": 34, "col": 2, "value_type": "STRING", "string_value": "职业守则"}, {"row": 34, "col": 3, "value_type": "STRING", "string_value": "职业道德"}, {"row": 34, "col": 4, "value_type": "STRING", "string_value": "职业规范"}, {"row": 34, "col": 5, "value_type": "STRING", "string_value": "职业秩序"}, {"row": 34, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 34, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 34, "col": 8, "value_type": "STRING", "string_value": "职业守则是员工在生产经营活动中恪守的行为规范。"}, {"row": 35, "col": 0, "value_type": "NUMBER", "number_value": 442}, {"row": 35, "col": 1, "value_type": "STRING", "string_value": "消防工作具有社会性、（  ）,行政性和技术性等特点"}, {"row": 35, "col": 2, "value_type": "STRING", "string_value": "偶然性"}, {"row": 35, "col": 3, "value_type": "STRING", "string_value": "突发性"}, {"row": 35, "col": 4, "value_type": "STRING", "string_value": "经常性"}, {"row": 35, "col": 5, "value_type": "STRING", "string_value": "必然性"}, {"row": 35, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 35, "col": 7, "value_type": "STRING", "string_value": "C"}, {"row": 35, "col": 8, "value_type": "STRING", "string_value": "消防工作的长期实践表明，其具有以下特点：1.社会性。2.行政性。3.经常性。4.技术性。"}, {"row": 36, "col": 0, "value_type": "NUMBER", "number_value": 443}, {"row": 36, "col": 1, "value_type": "STRING", "string_value": "人们在生产、生活、工作和学习中都需要用火，稍有疏漏，就有可能酿成火灾。由此可证明消防工作的特点具有（  ）。"}, {"row": 36, "col": 2, "value_type": "STRING", "string_value": "社会性"}, {"row": 36, "col": 3, "value_type": "STRING", "string_value": "行政性"}, {"row": 36, "col": 4, "value_type": "STRING", "string_value": "经常性"}, {"row": 36, "col": 5, "value_type": "STRING", "string_value": "技术性"}, {"row": 36, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 36, "col": 7, "value_type": "STRING", "string_value": "C"}, {"row": 36, "col": 8, "value_type": "STRING", "string_value": "无论是春夏秋冬，还是白天黑夜，每时每刻都有可能发生火灾。人们在生产、生活、工作和学习中都需要用火，稍有疏漏，就有可能酿成火灾。因此，这就决定了消防工作具有经常性。"}, {"row": 37, "col": 0, "value_type": "NUMBER", "number_value": 444}, {"row": 37, "col": 1, "value_type": "STRING", "string_value": "（  ）是政府社会管理和公共服务的重要内容，是社会稳定、经济发展的重要保障，各级政府必须加强对消防工作的领导。"}, {"row": 37, "col": 2, "value_type": "STRING", "string_value": "消防安全"}, {"row": 37, "col": 3, "value_type": "STRING", "string_value": "职业道德"}, {"row": 37, "col": 4, "value_type": "STRING", "string_value": "以人为本"}, {"row": 37, "col": 5, "value_type": "STRING", "string_value": "预防为主"}, {"row": 37, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 37, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 37, "col": 8, "value_type": "STRING", "string_value": "消防安全是政府社会管理和公共服务的重要内容，是社会稳定、经济发展的重要保障，各级政府必须加强对消防工作的领导。"}, {"row": 38, "col": 0, "value_type": "NUMBER", "number_value": 445}, {"row": 38, "col": 1, "value_type": "STRING", "string_value": "（  ）、单位、部门、公民四个方面都是消防工作的主体。"}, {"row": 38, "col": 2, "value_type": "STRING", "string_value": "预防"}, {"row": 38, "col": 3, "value_type": "STRING", "string_value": "灭火"}, {"row": 38, "col": 4, "value_type": "STRING", "string_value": "政府"}, {"row": 38, "col": 5, "value_type": "STRING", "string_value": "个人"}, {"row": 38, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 38, "col": 7, "value_type": "STRING", "string_value": "C"}, {"row": 38, "col": 8, "value_type": "STRING", "string_value": "“政府”“部门”“单位”“公民”四个方面都是消防工作的主体，只有各司其职、各负其责，才能保证消防工作顺利开展。"}, {"row": 39, "col": 0, "value_type": "NUMBER", "number_value": 446}, {"row": 39, "col": 1, "value_type": "STRING", "string_value": "消防工作具有广泛的（  ），它涉及社会的各个领域、各行各业、千家万户。凡是有人员工作、生活的地方都有可能发生火灾。"}, {"row": 39, "col": 2, "value_type": "STRING", "string_value": "社会性"}, {"row": 39, "col": 3, "value_type": "STRING", "string_value": "行政性"}, {"row": 39, "col": 4, "value_type": "STRING", "string_value": "经常性"}, {"row": 39, "col": 5, "value_type": "STRING", "string_value": "技术性"}, {"row": 39, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 39, "col": 7, "value_type": "STRING", "string_value": "A"}, {"row": 39, "col": 8, "value_type": "STRING", "string_value": "消防工作具有广泛的社会性，它涉及社会的各个领域、各行各业、千家万户。凡是有人员工作、生活的地方都有可能发生火灾。"}, {"row": 40, "col": 0, "value_type": "NUMBER", "number_value": 447}, {"row": 40, "col": 1, "value_type": "STRING", "string_value": "我国消防工作是一项由（  ）、部门依法监管、单位全面负责、公民积极参与、专业队伍与社会各方面协同、群防群治的预防和减少火灾危害，开展应急救援的公共消防安全的专门性工作。"}, {"row": 40, "col": 2, "value_type": "STRING", "string_value": "消防机构领导"}, {"row": 40, "col": 3, "value_type": "STRING", "string_value": "企业统一领导"}, {"row": 40, "col": 4, "value_type": "STRING", "string_value": "政府统一领导"}, {"row": 40, "col": 5, "value_type": "STRING", "string_value": "救援机构领导"}, {"row": 40, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 40, "col": 7, "value_type": "STRING", "string_value": "C"}, {"row": 40, "col": 8, "value_type": "STRING", "string_value": "我国消防工作是一项由政府统一领导、部门依法监管、单位全面负责、公民积极参与、专业队伍与社会各方面协同、群防群治的预防和减少火灾危害，开展应急救援的公共消防安全的专门性工作。"}, {"row": 41, "col": 0, "value_type": "NUMBER", "number_value": 448}, {"row": 41, "col": 1, "value_type": "STRING", "string_value": "我国消防工作贯彻（  ）的方针。"}, {"row": 41, "col": 2, "value_type": "STRING", "string_value": "以防为主，防消结合"}, {"row": 41, "col": 3, "value_type": "STRING", "string_value": "预防为主，防消结合"}, {"row": 41, "col": 4, "value_type": "STRING", "string_value": "专门机关和群众相结合"}, {"row": 41, "col": 5, "value_type": "STRING", "string_value": "以防为主，以消为辅"}, {"row": 41, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 41, "col": 7, "value_type": "STRING", "string_value": "B"}, {"row": 41, "col": 8, "value_type": "STRING", "string_value": "消防工作贯彻“预防为主、防消结合”的方针。"}, {"row": 42, "col": 0, "value_type": "NUMBER", "number_value": 449}, {"row": 42, "col": 1, "value_type": "STRING", "string_value": "举办大型群众性活动，承办人应当依法向（  ）申请安全许可。"}, {"row": 42, "col": 2, "value_type": "STRING", "string_value": "消防机构"}, {"row": 42, "col": 3, "value_type": "STRING", "string_value": "人民政府"}, {"row": 42, "col": 4, "value_type": "STRING", "string_value": "公安机关"}, {"row": 42, "col": 5, "value_type": "STRING", "string_value": "监督部门"}, {"row": 42, "col": 6, "value_type": "STRING", "string_value": ""}, {"row": 42, "col": 7, "value_type": "STRING", "string_value": "C"}, {"row": 42, "col": 8, "value_type": "STRING", "string_value": "举办大型群众性活动，承办人应当依法向公安机关申请安全许可。"}, {"row": 43, "col": 0, "value_type": "NUMBER", "number_value": 450}, {"row": 43, "col": 1, "value_type": "STRING", "string_value": "消防救援机构应当对机关、团体、企业、事业等单位遵守消防法律法规的情况依法进行（  ）。"}, {"row": 43, "c